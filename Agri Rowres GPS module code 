#include <TinyGPSPlus.h>

TinyGPSPlus gps;

// Use Hardware Serial2
HardwareSerial gpsSerial(2);

// GPS Pins
#define GPS_RX 16   // ESP32 RX <- GPS TX
#define GPS_TX 17   // ESP32 TX -> GPS RX

void setup()
{
  Serial.begin(115200);

  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);

  Serial.println();
  Serial.println("========================================");
  Serial.println("      ESP32 GPS Information");
  Serial.println("========================================");
  Serial.println("Waiting for GPS satellites...");
}

void loop()
{
  while (gpsSerial.available())
  {
    gps.encode(gpsSerial.read());
  }

  static unsigned long lastPrint = 0;

  if (millis() - lastPrint >= 1000)
  {
    lastPrint = millis();

    if (gps.location.isValid())
    {
      printGPSData();
    }
    else
    {
      Serial.println("----------------------------------------");
      Serial.println("Waiting for GPS Fix...");
      Serial.print("Satellites : ");
      Serial.println(gps.satellites.value());

      if (gps.hdop.isValid())
      {
        Serial.print("HDOP       : ");
        Serial.println(gps.hdop.hdop());
      }

      Serial.println("----------------------------------------");
    }
  }

  if (millis() > 10000 && gps.charsProcessed() < 10)
  {
    Serial.println();
    Serial.println("ERROR: GPS module not detected!");
    Serial.println("Check:");
    Serial.println("1. TX -> GPIO16");
    Serial.println("2. RX -> GPIO17");
    Serial.println("3. Power Supply");
    Serial.println("4. Baud Rate (9600)");
    while (1);
  }
}

void printGPSData()
{
  Serial.println();
  Serial.println("========================================");

  Serial.print("Latitude      : ");
  Serial.println(gps.location.lat(), 6);

  Serial.print("Longitude     : ");
  Serial.println(gps.location.lng(), 6);

  Serial.print("Altitude      : ");
  Serial.print(gps.altitude.meters());
  Serial.println(" m");

  Serial.print("Speed         : ");
  Serial.print(gps.speed.kmph());
  Serial.println(" km/h");

  Serial.print("Course        : ");
  Serial.print(gps.course.deg());
  Serial.println(" deg");

  Serial.print("Satellites    : ");
  Serial.println(gps.satellites.value());

  Serial.print("HDOP          : ");
  if (gps.hdop.isValid())
    Serial.println(gps.hdop.hdop());
  else
    Serial.println("N/A");

  Serial.print("Date          : ");
  if (gps.date.isValid())
  {
    Serial.printf("%02d/%02d/%04d\n",
                  gps.date.day(),
                  gps.date.month(),
                  gps.date.year());
  }
  else
  {
    Serial.println("Invalid");
  }

  Serial.print("Time (UTC)    : ");
  if (gps.time.isValid())
  {
    Serial.printf("%02d:%02d:%02d\n",
                  gps.time.hour(),
                  gps.time.minute(),
                  gps.time.second());
  }
  else
  {
    Serial.println("Invalid");
  }

  Serial.println("========================================");
}